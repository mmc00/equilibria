   5213       END OF GTAPVol
   5214       --------------
   5215   >!
   5216   postsim (end);
   5217   !<
   5218       -----------------------------------
   5219       END OF post-simulation calculations
   5220       -----------------------------------
   5221   >!
   5222    
   5223   !<
   5224       ----------------------------------------------
   5225       E. Data balance check and summary calculations
   5226       ----------------------------------------------
   5227   >!
   5228    
   5229   Set
   5230       COSTS # industry cost summary # = "IntDom" + "IntImp" + ENDW + "PTAX"  ;
   5231   Set
   5232       GDPIN # income-side GDP # = ENDW + "IndTaxes";
   5233   Set
   5234       SALES # Commodity Sales Summary #
   5235       (Intermediate,Household,Investment,Government,Exports,IntnlMargins);
   5236    
   5237   Coefficient (all,a,ACTS)(all,r,REG)(all,c,COSTS)
   5238       COSTSUM(a,r,c) # industry cost summary #;
   5239   Formula
   5240    (all,a,ACTS)(all,r,REG) COSTSUM(a,r,"IntDom") = sum{c,COMM, VDFP(c,a,r)};
   5241    (all,a,ACTS)(all,r,REG) COSTSUM(a,r,"IntImp") = sum{c,COMM, VMFP(c,a,r)};
   5242    (all,a,ACTS)(all,r,REG)(all,e,ENDW) COSTSUM(a,r,e) = EVFP(e,a,r);
   5243    (all,a,ACTS)(all,r,REG) COSTSUM(a,r,"PTAX")   = sum{c,COMM, PTAX(c,a,r)};
   5244    (all,a,ACTS)(all,r,REG)(all,e,ENDW) COSTSUM(a,r,e) = EVFP(e,a,r);
   5245    (all,a,ACTS)(all,r,REG) COSTSUM(a,r,"PTAX")   = sum{c,COMM, PTAX(c,a,r)};
   5246   Write
   5247       COSTSUM to file GTAPSUM header "COST";
   5248    
   5249   Coefficient (all,r,REG)(all,g,GDPIN)
   5250      GDPINC(r,g) # income-side GDP #;
   5251   Formula
   5252      (all,r,REG)(all,e,ENDW) GDPINC(r,e) = sum{a,ACTS, EVFP(e,a,r)};
   5253      (all,r,REG) GDPINC(r,"IndTaxes") =   INDTAX(r) - TAXRFU(r);
   5254   Write
   5255       GDPINC to file GTAPSUM header "GDPI";
   5256    
   5257   Coefficient (all,c,COMM)(all,r,REG)(all,s,SALES)
   5258       SALESUM(c,r,s) # commodity sales summary #;
   5259   Formula
   5260   (all,c,COMM)(all,r,REG) SALESUM(c,r,"Intermediate") = sum{a,ACTS, VDFB(c,a,r)};
   5261   (all,c,COMM)(all,r,REG) SALESUM(c,r,"Household")    = VDPB(c,r);
   5262   (all,c,COMM)(all,r,REG) SALESUM(c,r,"Investment")   = VDIB(c,r);
   5263   (all,c,COMM)(all,r,REG) SALESUM(c,r,"Government")   = VDGB(c,r);
   5264   (all,c,COMM)(all,r,REG) SALESUM(c,r,"Exports")      = VXDXSB(c,r);
   5265   (all,c,MARG)(all,r,REG) SALESUM(c,r,"IntnlMargins") = VST(c,r);
   5266   (all,c,NMRG)(all,r,REG) SALESUM(c,r,"IntnlMargins") = 0;
   5267   Write
   5268       SALESUM to file GTAPSUM header "SALE";
   5269    
   5270   Coefficient (all,c,COMM)(all,r,REG)
   5271       VDBCHK(c,r) # VCB(c,r) - MAKEBCOM(c,r) should be tiny #;
   5272   Formula (all,c,COMM)(all,r,REG)
   5273       VDBCHK(c,r) = VCB(c,r) - MAKEBCOM(c,r);
   5274   Write
   5275       VDBCHK to file GTAPSUM header "VMCK";
   5276   Formula (all,c,COMM)(all,r,REG)
   5277       VDBCHK(c,r) = 100 * VDBCHK(c,r) / VCB(c,r);
   5278   Write
   5279       VDBCHK to file GTAPSUM header "VMCP" longname "VDBCHK as %";
   5280    
   5281   Coefficient (all,c,COMM)(all,s,REG)(all,d,REG)
   5282       TRDCHK(c,s,d) # VCIF(c,s,d) - [VFOB(c,s,d) + VTFSD(c,s,d)] should be tiny #;
   5283   Formula (all,c,COMM)(all,s,REG)(all,d,REG)
   5284       TRDCHK(c,s,d) = VCIF(c,s,d) - [VFOB(c,s,d) + VTFSD(c,s,d)];
   5285   Write
   5286       TRDCHK to file GTAPSUM header "TRCK";
   5287   Formula (all,c,COMM)(all,s,REG)(all,d,REG)
   5288       TRDCHK(c,s,d) = 100 * TRDCHK(c,s,d) / VCIF(c,s,d);
   5289   Write
   5290       TRDCHK to file GTAPSUM header "TRCP" longname "TRDCHK as %";
   5291    
   5292   Coefficient (all,m,MARG)
   5293       VTMCHK(m) # VTMUSE(m) - VTMPROV(m) should be tiny #;
   5294   Formula (all,m,MARG)
   5295       VTMCHK(m) = VTMUSE(m) - VTMPROV(m);
   5296   Write
   5297       VTMCHK to file GTAPSUM header "VTCK";
   5298   Formula (all,m,MARG)
   5299       VTMCHK(m) = 100 * VTMCHK(m) / VTMUSE(m);
   5300   Write
   5301       VTMCHK to file GTAPSUM header "VTCP" longname "VTMCHK as %";
   5302    
   5303   Coefficient (all,c,COMM)(all,r,REG)
   5304       CHKMKClIMP(c,r) # Checking the accounting on imports supply and demand #;
   5305   Formula (all,c,COMM)(all,r,REG)
   5306       CHKMKClIMP(c,r)
   5307           = sum{s,REG, VMSB(c,s,r)}
   5308           - sum{a,ACTS, VMFB(c,a,r)}
   5309           - VMPB(c,r) - VMGB(c,r) - VMIB(c,r);
   5310   Write
   5311       CHKMKClIMP to file GTAPSUM header "MPCK";
   5312   Formula (all,c,COMM)(all,r,REG)
   5313       CHKMKClIMP(c,r) = 100 * CHKMKClIMP(c,r) / [sum{s,REG, VMSB(c,s,r)}];
   5314    
   5315   Write
   5316       CHKMKClIMP to file GTAPSUM header "MPCP" longname "CHKMKClIMP as %";
   5317    
   5318   Coefficient (all,c,COMM)(all,a,ACTS)(all,r,REG)
   5319       VOSCHK(c,a,r) # MAKEB - [MAKES + PTAX] should be tiny #;
   5320   Formula (all,c,COMM)(all,a,ACTS)(all,r,REG)
   5321       VOSCHK(c,a,r) = MAKEB(c,a,r) - [MAKES(c,a,r) + PTAX(c,a,r)];
   5322   Write
   5323       VOSCHK to file GTAPSUM header "VOCK";
   5324   Formula (all,c,COMM)(all,a,ACTS)(all,r,REG)
   5325       VOSCHK(c,a,r) = 100 * VOSCHK(c,a,r) / MAKEB(c,a,r);
   5326   Write
   5327       VOSCHK to file GTAPSUM header "VOCS" longname "VOSCHK as %";
   5328    
   5329   postsim (begin);
   5330   Write
   5331       VDBCHK to file GTAPSUM header "VMCQ" longname "PostSim VDBCHK as %";
   5332       TRDCHK to file GTAPSUM header "TRCQ" longname "PostSim TRDCHK as %";
   5333       VTMCHK to file GTAPSUM header "VTCQ" longname "PostSim VTMCHK as %";
   5334       CHKMKClIMP to file GTAPSUM header "MPCQ" longname "PostSim CHKMKClIMP as %";
   5335       VOSCHK to file GTAPSUM header "VOCQ" longname "PostSim VOPCHK as %";
   5336   postsim (end);
   5337   !<
   5338       =====================
   5339       END OF GTAP.TAB FILE
   5340       =====================
   5341   >!
 
 %%INFORMATION. TABLO has created 4 new sets as follows:
  S@IntDom # Set with one element IntDom, a subset of COSTS #
  S@IntImp # Set with one element IntImp, a subset of COSTS #
  S@PTAX # Set with one element PTAX, a subset of COSTS #
  S@IndTaxes # Set with one element IndTaxes, a subset of GDPIN #
 




