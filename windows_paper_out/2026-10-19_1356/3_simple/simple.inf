 -->                     Starting CHECK stage

 ******************************************************************************


      1   File INFILE # base data file #;
      2   Set
      3    COM # Commodities # read elements from file INFILE header "SEC";
      4    IND # Industries #  read elements from file INFILE header "SEC";
      5    FIN # Final users # (Hou,Gov,Inv,Exp);
      6    LOCFIN # Local final users # (Hou,Gov,Inv);
      7    USR # All users # = IND + FIN;
      8    LOCUSR # Local users # = IND + LOCFIN;
      9    SRC (dom,imp);
     10    FAC (Capital,Labor);
     11    SEC = COM intersect IND;
     12   Subset LOCUSR is subset of USR;
     13    
     14   Coefficient ! data on file !
     15   (all,c,COM)(all,s,SRC)(all,u,USR) USE(c,s,u) # Value of inputs #;
     16   (all,f,FAC)(all,i,IND)           FACTOR(f,i) # Primary factor costs #;
     17   (parameter)(all,c,COM)              SIGMA(c) # CES dom-imp elasticity #;
     18   Read
     19    USE    from file INFILE header "USE";
     20    FACTOR from file INFILE header "FACT";
     21    SIGMA  from file INFILE header "SIG";
     22    
     23   Coefficient ! calculated !
     24   (all,c,COM)(all,u,USR) USE_S(c,u) # Value of import composites #;
     25   (all,i,IND)             VALADD(i) # Factor costs #;
     26   (all,u,USR)              COSTS(u) # Costs #;
     27   (all,c,COM)(all,s,SRC) SALES(c,s) # Sales #;
     28   (all,q,SEC)               DIFF(q) # Costs-Sales #;
     29                                VGDP # GDP #;
     30   Formula
     31   (all,c,COM)(all,u,USR) USE_S(c,u) = sum{s,SRC, USE(c,s,u)};
     32   (all,i,IND)             VALADD(i) = sum{f,FAC,FACTOR(f,i)};
     33   (all,u,USR)              COSTS(u) = sum{c,COM, USE_S(c,u)};
     34   (all,i,IND)              COSTS(i) = COSTS(i) + VALADD(i);
     35   (all,c,COM)(all,s,SRC) SALES(c,s) = sum{u,USR, USE(c,s,u)};
     36   (all,q,SEC)               DIFF(q) = COSTS(q) - SALES(q,"dom");
     37                                VGDP = sum{i,IND,VALADD(i)};
     38   Assertion # Check data balance # (all,q,SEC) ABS[DIFF(q)]<0.001;
     39    
     40   Variable
     41                      (change) delB # (Nominal balance of trade)/{nominal GDP} #;
     42                               xgdp # Real GDP #;
     43                            wgdpinc # Nominal GDP from income side #;
     44                            wgdpexp # Nominal GDP from expenditure side #;
     45                                phi # Exchange rate (local$/foreign$) #;
     46                (all,c,COM) xexp(c) # Export quantities #;
     47               (all,c,COM) fqexp(c) # Right shift in export demand curve #;
     48                   (all,i,IND) z(i) # Industry outputs #;
     49               (all,c,COM) pfimp(c) # Imp goods prices, foreign $ #;
     50             (all,l,LOCFIN) wtot(l) # Nominal expenditure by local final users #;
     51             (all,l,LOCFIN) ftot(l) # wtot/GDP #;
     52             (all,l,LOCFIN) xtot(l) # Real expenditure by local final users #;
     53             (all,l,LOCFIN) ptot(l) # Price indices for local final users #;
     54              (all,f,FAC) xfac_i(f) # Total value-weighted factor use #;
     55              (all,f,FAC) ffac_i(f) # Factor wage shift #;
     56   (all,c,COM)(all,s,SRC)    p(c,s) # Commodity prices #;
     57   (all,c,COM)(all,s,SRC) xdem(c,s) # Total demand for goods #;
     58   (all,f,FAC)(all,i,IND) pfac(f,i) # Factor prices #;
     59   (all,i,IND)            pfac_f(i) # Factor composite prices #;
     60   (all,f,FAC)(all,i,IND) xfac(f,i) # Factor use #;
     61   (all,f,FAC)(all,i,IND) afac(f,i) # Factor-using technical change #;
     62   (all,f,FAC)(all,i,IND) ffac(f,i) # Factor wage shift #;
     63   (all,c,COM)(all,l,LOCUSR) pcomp(c,l) # Price dom/imp composites#;
     64   (all,c,COM)(all,l,LOCUSR) xcomp(c,l) # Quantity dom/imp composites#;
     65   (all,c,COM)(all,s,SRC)(all,l,LOCUSR) x(c,s,l) # Commodity demands #;
     66    
     67   Equation
     68   ! Dom/imp CES BLOCK !
     69   E_pcomp # Price: dom/imp composites # (all,c,COM)(all,u,LOCUSR)
     70    ID01[USE_S(c,u)]*pcomp(c,u)=sum{s,SRC,USE(c,s,u)*p(c,s)};
     71   E_x # Quant: final dom/imp composites# (all,c,COM)(all,s,SRC)(all,l,LOCUSR)
     72    x(c,s,l) = xcomp(c,l) - SIGMA(c)*[p(c,s)-pcomp(c,l)];
     73    
     74   ! Industry demands !
     75   E_pA  # Industry cost indices # (all,i,SEC)
     76    ID01[COSTS(i)]*p(i,"dom")=sum{c,COM,USE_S(c,i)*pcomp(c,i)}+VALADD(i)*pfac_f(i);
     77   E_pfac_f # Factor composite prices # (all,i,IND)
     78    ID01[VALADD(i)]*pfac_f(i) = sum{f,FAC, FACTOR(f,i)*[pfac(f,i)+afac(f,i)]};
     79   E_xfac # Factor demands (CES) # (all,f,FAC)(all,i,IND)
     80    xfac(f,i) = z(i) + afac(f,i) - 0.5*[pfac(f,i)+afac(f,i)-pfac_f(i)];
     81   E_xcompA # Intermediate demands (Leontief) # (all,c,COM)(all,i,IND)
     82    xcomp(c,i) = z(i);
     83    
     84   ! Final demanders !
     85   E_xcompB # Local final demands (Cobb-Douglas) # (all,c,COM)(all,l,LOCFIN)
     86    xcomp(c,l) + pcomp(c,l) = wtot(l);
     87   E_wtot  # Absorption # (all,l,LOCFIN) wtot(l) = ftot(l) + wgdpinc;
     88   E_ptot  # Price indices for local final users # (all,l,LOCFIN)
     89    ID01[COSTS(l)]*ptot(l) = sum{c,COM, USE_S(c,l)*pcomp(c,l)};
     90   E_xtot  # Real expenditure by local final users # (all,l,LOCFIN)
     91    xtot(l) + ptot(l) = wtot(l);
     92   E_xexp  # Export demands #  (all,c,COM)
     93    xexp(c) = fqexp(c) -5.0*[p(c,"dom")-phi];
     94    
     95   ! Total demands and market clearing !
     96   E_ffac_i  # Total (value-weighted) factor use # (all,f,FAC)
     97    sum{i,IND,FACTOR(f,i)*[xfac_i(f) - xfac(f,i)]} = 0;
     98   E_xdem    # Total demand for goods # (all,c,COM)(all,s,SRC)
     99    ID01[SALES(c,s)]*xdem(c,s) =
    100       sum{l,LOCUSR,USE(c,s,l)*x(c,s,l)} + USE(c,s,"exp")*xexp(c);
    101   E_z       # Market clearing # (all,i,SEC) z(i) = xdem(i,"dom");
    102    
    103   ! Miscellaneous !
    104   E_pB      # Import prices # (all,i,SEC) p(i,"imp") = pfimp(i) + phi;
    105   E_pfac    # Factor mobility/remuneration # (all,f,FAC)(all,i,IND)
    106    pfac(f,i) = ptot("hou") + ffac(f,i) + ffac_i(f);
    107   E_wgdpinc # Nominal GDP from income side #
    108    VGDP*wgdpinc = sum{i,IND, sum{f,FAC, FACTOR(f,i)*[pfac(f,i)+xfac(f,i)]}};
    109   E_xgdp    # Real GDP from income side #
    110    VGDP*xgdp = sum{i,IND, sum{f,FAC, FACTOR(f,i)*[xfac(f,i)-afac(f,i)]}};
    111   E_wgdpexp # Nominal GDP from expenditure side #
    112    VGDP*wgdpexp= sum{c,COM, sum{l,LOCFIN, USE_S(c,l)*wtot(l)}
    113     + USE(c,"dom","exp")*[p(c,"dom")+xexp(c)]
    114     - SALES(c,"imp")*[p(c,"imp")+xdem(c,"imp")]};
    115   E_delB    # (balance of trade)/GDP #
    116     100*VGDP*delB = sum{c,COM,USE(c,"dom","exp")*[p(c,"dom")+xexp(c)-wgdpinc]}
    117                   - sum{c,COM,SALES(c,"imp")*[p(c,"imp")+xdem(c,"imp")-wgdpinc]};
    118    
    119   Update
    120   (all,i,IND)(all,f,FAC) FACTOR(f,i)=pfac(f,i)*xfac(f,i);
    121   (all,c,COM)(all,s,SRC)(all,l,LOCUSR) USE(c,s,l) = p(c,s)*x(c,s,l);
    122   (all,c,COM) USE(c,"dom","exp") = p(c,"dom")*xexp(c);
    123   Backsolve x using E_x; pcomp using E_pcomp;
    124    
 
 %%INFORMATION. TABLO has created 1 new sets as follows:
  S@exp # Set with one element exp, a subset of USR #
 




