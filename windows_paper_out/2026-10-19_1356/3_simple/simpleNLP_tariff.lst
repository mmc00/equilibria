   5   
   6  * Convention: variables (and initial values of variables) are in lowercase,
   7  * other parameters are in upper case
   8   
   9  *======================== (1) Set Declaration ============================
  10  * Declare and read Sets and Parameters stored in GDX
  11  Set     ! on data file
  12   USR      Users
  13   FAC      Factors
  14   LOCUSR(USR) Local users
  15   COM(LOCUSR) Commodities
  16   IND(COM) Industries
  17   LOCFIN(LOCUSR) Local final users
  18   SEC(IND)      Sectors
  19   SRC      Sources / dom, imp / ;
  20  Parameter    ! on data file
  21   USE(COM,SRC,USR) Value of inputs
  22   FACTOR(FAC,IND)  Primary factor costs
  23   SIGMA(COM)       CES dom-imp elasticity   ;
GDXIN   C:\Documentos\proyectos\equilibria\runs\horridge_simple\input.gdx
--- LOAD  USR = 6:USR
--- LOAD  FAC = 10:FAC
--- LOAD  LOCUSR = 8:LOCUSR
--- LOAD  COM = 2:COM
--- LOAD  IND = 3:IND
--- LOAD  LOCFIN = 9:LOCFIN
--- LOAD  SEC = 4:SEC
--- LOAD  FACTOR = 12:FACTOR
--- LOAD  USE = 11:USE
--- LOAD  SIGMA = 13:SIGMA
  26   
  27  Set     ! Additional Sets
  28   FIN(USR)       Final users         / Hou, Gov, Inv, Exp /
  29   EXP(USR)       Exports             / Exp / ;
  30   
  31  Alias (IND,i),(COM,c),(SRC,s),(USR,u),(FAC,f),(f,ff),(LOCFIN,lf),(LOCUSR,lu),(FIN,fu);
  32   
  33  *--- alter data to avoid problems
  34  * USE(c,s,u) $(USE(c,s,u) eq 0) = 1E-9;  ! avoid zero problems
  35   FACTOR(f,i)$(FACTOR(f,i)eq 0) = 1E-9;
  36   SIGMA(c) $(SIGMA(c)eq 1)  = 1.0001;   !NOTE: CES sigma must not equal 1
  37   
  38  Parameter   ! addups of base data
  39   VALADD0(i)       Factor costs
  40   COSTS0(i)        Costs
  41   SALES0(c,s)      Sales
  42   DIFF(i)          Costs - sales ;
  43   
  44   VALADD0(i)   = SUM[f,FACTOR(f,i)];
  45   COSTS0(i)    = VALADD0(i) + SUM((c,s), USE(c,s,i));
  46   SALES0(c,s)  = SUM(u, USE(c,s,u));
  47   DIFF(i)      = SALES0(i,"dom")- COSTS0(i);
  48   
  49  DISPLAY VALADD0, COSTS0, SALES0, DIFF, FACTOR;
  50  ABORT$(ABS{SUM[i, DIFF(i)]} GT 0.01)"!!!DATA BALANCE PROBLEM!!!";
  51  *======================= (2) Parameter declarations ======================
  52  Parameter   ! initial values of variables (and variables) are in lower case
  53   ffac0(f,i)       Factor wage shift
  54   pfac0(f,i)       Factor prices
  55   pfac_f0(i)       Factor composite prices
  56   xfac0(f,i)       Factor use
  57   xfac_i0(f)       Total value-weighted factor use
  58   ffac_i0(f)       Factor wage shift
  59   xfac_f0(i)       Total factor use by industry
  60   z0(i)            Industry outputs
  61   x0(c,s,lu)       Value of inputs
  62   wtot0(lf)        Nominal expenditure by local final users
  63   xtot0(lf)        Real expenditure by local final users
  64   xdem0(c,s)       Total demand for goods
  65   xcomp0(c,lu)     Quant: final dom-imp composites
  66   ptot0(lf)        Price indices for local final users
  67   p0(c,s)          Goods prices
  68   pcomp0(c,lu)     Price: Intermediate dom-imp composites for local users
  69   wgdpinc0         Nominal GDP from income side
  70   wgdpexp0         Nominal GDP from expenditure side
  71   delB0            Trade balance
  72   phi0             Exchange rate
  73   pfimp0(c)        Imported goods prices-foreign $
  74   xexp0(c)         Export demand
  75   ftot0(lf)        Absorption parameter
  76   afac0(f,i)       Factor shifter
  77   fqexp0(c)        Initial value of export shifter;
  78   
  79  *-- Assign initial values
  80   pcomp0(c,lu) = 1;
  81   p0(c,s)      = 1;
  82   pfac_f0(i)   = 1;
  83   pfac0(f,i)   = 1;
  84   pfimp0(c)    = 1;
  85   ptot0(lf)    = 1;
  86   ffac0(f,i)   = 1;
  87   ffac_i0(f)   = 1;
  88   afac0(f,i)   = 1;
  89   phi0         = 1;
  90   
  91  *use(c,s,lu)$(not round(use(c,s,lu),7)) = 0;
  92   
  93  *--- Volumes calculations
  94   x0(c,s,lu)     = USE(c,s,lu)/p0(c,s);
  95   xcomp0(c,lu)   = SUM[s,USE(c,s,lu)]/pcomp0(c,lu);
  96   xexp0(c)       = USE(c,"dom","exp")/p0(c,"dom");
  97   
  98   
  99   
 100  *--- Initial Data for use in calibration
 101   xfac0(f,i)  = FACTOR(f,i)/pfac0(f,i);
 102   xfac_f0(i)  = VALADD0(i)/pfac_f0(i);
 103   xfac_i0(f)  = SUM[i, FACTOR(f,i)/pfac0(f,i)];
 104   z0(i)       = COSTS0(i)/p0(i,"dom");
 105   wtot0(lf)   = SUM[(c,s), USE(c,s,lf)];
 106   xtot0(lf)   = wtot0(lf)/ptot0(lf);
 107   xdem0(c,s)  = SUM[lu, x0(c,s,lu)];
 108   xdem0(c,"dom") = xdem0(c,"dom") + xexp0(c);
 109   
 110  *--- Other initial values
 111   fqexp0(c)   = xexp0(c)*[p0(c,"dom")/phi0]**(5) ;
 112   wgdpinc0    = SUM{i, SUM[f,FACTOR(f,i)]};
 113   delB0       = SUM[c, USE(c,"dom","exp")] - SUM[(c,u), USE(c,"imp",u)];
 114   wgdpexp0    = SUM[(c,s,lf), USE(c,s,lf)] + delB0;
 115   delB0       = delB0 / wgdpinc0;
 116   ftot0(lf)   = wtot0(lf)/wgdpinc0;
 117   
 118  *======================== (3) Calibration  ===============================
 119  Parameter   ! Calibrate CES dom-imp
 120   A_ARM(c,s,lu) Armington shares ;
 121   A_ARM(c,s,lu)$xcomp0(c,lu)  = x0(c,s,lu)/xcomp0(c,lu)
 122                                  *[pcomp0(c,lu)/p0(c,s)]**SIGMA(c);
 123   
 124  Parameter   ! Calibrate CES primary factor
 125   SIGMA_FAC(i)     Elasticity in factor use
 126   ALPHA_F(f,i)     Share of factor in CES value added
 127   RHO_F(i)         Rho parameter in  CES value added
 128   A_F(i)           Technology parameter in CES value added;
 129   SIGMA_FAC(i)   = 0.5;
 130   RHO_F(i)       = (1-SIGMA_FAC(i))/SIGMA_FAC(i);
 131   ALPHA_F(f,i)   = pfac0(F,I)*xfac0(f,i)**(1+RHO_F(i))/
 132                     SUM{ff,pfac0(ff,I)*xfac0(ff,i)**[1+RHO_F(i)]};
 133   A_F(i)         = xfac_f0(i)/SUM[f,ALPHA_F(f,i)*xfac0(f,i)**(-RHO_F(i))]**(-1/RHO_F(i));
 134   
 135  Parameter   ! Calibrate Leontief coefficient
 136   VA_COEF(i)    Value added (Leontief) coefficient for industries
 137   INT_COEF(c,i) Intermediate (Leontief) coefficient for industries;
 138   VA_COEF(i)    = z0(i)/xfac_f0(i);
 139   INT_COEF(c,i) $xcomp0(c,i) = z0(i)/xcomp0(c,i);
 140   
 141  Parameter   ! Calibrate Cobb-Douglas for final users
 142   ALPHA_LF(c,lf) CD Shares of local final users
 143   A_LF(lf)       CD Shift parameter for local final users ;
 144   ALPHA_LF(c,lf) = [xcomp0(c,lf)*pcomp0(c,lf)]/wtot0(lf);
 145   A_LF(lf)       = xtot0(lf)/{PROD[c,xcomp0(c,lf)**ALPHA_LF(c,lf)]}
 146   
 147  *========================== (4) MODEL ====================================
 148  Variable
 149   pcomp(c,lu)      Price of Composite dom-imp commodity
 150   p(c,s)           Goods' prices
 151   pfac_f(i)        Composite factor prices
 152   pfac(f,i)        Price of Factors
 153   ptot(lf)         Price indices for local final users
 154   phi              Exchange rate
 155   pfimp(i)         Import prices
 156   xcomp(c,lu)      Composite commodity
 157   x(c,s,lu)        Intermediate demand
 158   xfac_f(i)        Total factor use
 159   xtot(lf)         Total output of local final user
 160   xfac(f,i)        Factor demand
 161   xfac_i(f)        Total factor use
 162   xtot(lf)         Real expenditure of local final users
 163   xexp(c)          Export demand
 164   xdem(c,s)        Total demand for goods
 165   z(i)             Output of industry
 166   wtot(lf)         Nominal expenditure by local final users
 167   wgdpinc          Nominal GDP - income side
 168   wgdpexp          Nominal GDP expenditure side
 169   delB             Trade Balance
 170   afac(f,i)        Factor using technical change
 171   ffac_i(f)        Factor wage shifter
 172   ffac(f,i)        Factor wage shifter
 173   ftot(lf)         Absorption parameter for local final users
 174   fqexp(c)         Export shifter
 175   OBJ              NLP objective function ;
 176   
 177  Equation   !  Dom-imp Block
 178   E_pcomp          Price of Composite dom-imp commodity
 179   E_xcomp1         Dom-imp Composite for industries (Leontief)
 180   E_xcomp2         Dom-imp Composite for local final users (Cobb-Douglas)
 181   E_x              Intermediate demand ;
 182   
 183   E_pcomp(c,lu)$xcomp0(c,lu)..  pcomp(c,lu)*xcomp(c,lu) =e= SUM[s, x(c,s,lu)*p(c,s)];
 184   
 185   E_xcomp1(c,i)$xcomp0(c,i)..  xcomp(c,i) =e= z(i)/INT_COEF(c,i);
 186   
 187   E_xcomp2(c,lf).. xcomp(c,lf)*pcomp(c,lf) =e= ALPHA_LF(c,lf)*wtot(lf);
 188   
 189   E_x(c,s,lu)..  x(c,s,lu)=e= A_ARM(c,s,lu)*xcomp(c,lu)*[pcomp(c,lu)/p(c,s)]**SIGMA(c);
 190   
 191  Equation   ! Industry demands
 192   E_pA             Industry cost indices
 193   E_pfac_f         Composite factor prices
 194   E_xfac           Demand for factors
 195   E_xfac_f         Composite factor CES  ;
 196   
 197   E_pA(i,"dom")..  p(i,"dom")*z(i) =e= SUM[c,xcomp(c,i)*pcomp(c,i)] + xfac_f(i)*pfac_f(i);
 198   
 199   E_pfac_f(i)..    pfac_f(i)*xfac_f(i) =e= SUM[f, xfac(f,i)*pfac(f,i)];
 200   
 201   E_xfac(f,i)..    xfac(f,i)/xfac_f(i) =e= [afac(f,i)*ALPHA_F(f,i)*pfac_f(i)/pfac(f,i)]
 202                        **SIGMA_FAC(i)*A_F(i)**(SIGMA_FAC(i)-1);
 203   
 204   E_xfac_f(i)..    xfac_f(i)*VA_COEF(i) =e= z(i);
 205   
 206  Equation   ! Final demanders
 207   E_wtot           Nominal expenditure by local final users
 208   E_ptot           Price indices for local final users
 209   E_xtot           Real expenditure by local final users
 210   E_xexp           Export demand  ;
 211   
 212   E_wtot(lf)..     wtot(lf) =e= ftot(lf)*wgdpinc;
 213   
 214   E_ptot(lf)..     ptot(lf) =e= [1/A_LF(lf)]*
 215                  PROD{c$ALPHA_LF(c,lf),[pcomp(c,lf)/ALPHA_LF(c,lf)]
 216                                  **ALPHA_LF(c,lf)};
 217   
 218   E_xtot(lf)..     xtot(lf)*ptot(lf) =e= wtot(lf);
 219   
 220   E_xexp(c)..      xexp(c) =e= fqexp(c)*[p(c,"dom")/phi]**(-5) ;
 221   
 222  Equation   !  Total demand and market clearing
 223   E_ffac_i         Total factor use
 224   E_xdemA          Total demand for dom goods
 225   E_xdemB          Total demand for imp goods
 226   E_z(i)           Market clearing ;
 227   
 228   E_ffac_i(f)..    xfac_i(f) =e= SUM[i, xfac(f,i)];
 229   
 230   E_xdemA(c)..     xdem(c,"dom") =e= SUM[lu, x(c,"dom",lu)] + xexp(c);
 231   
 232   E_xdemB(c)..     xdem(c,"imp") =e= SUM[lu, x(c,"imp",lu)];
 233   
 234   E_z(i)..         z(i) =e= xdem(i,"dom");
 235   
 236  Equation   ! Miscellaneous equations
 237   E_pB(i)          Import prices
 238   E_pfac(f,i)      Factor remuneration
 239   E_wgdpinc        Nominal GDP income
 240   E_wgdpexp        Nominal GDP expenditure
 241   E_delB           Trade Balance
 242   E_OBJ            NLP objective function      ;
 243   
 244   E_pB(i)..        p(i,"imp") =e= pfimp(i)*phi ;
 245   
 246   E_pfac(f,i)..    pfac(f,i) =e= ffac_I(f)*ffac(f,i)* ptot("hou");
 247   
 248   E_wgdpinc..      wgdpinc =e= SUM{i, SUM[f,xfac(f,i)*pfac(f,i)]};
 249   
 250   E_wgdpexp..      wgdpexp =e= SUM[(c,lf)$xcomp0(c,lf), xcomp(c,lf)*pcomp(c,lf)]
 251                             + SUM[c, xexp(c)*p(c,"dom") - xdem(c,"imp")*p(c,"imp")];
 252   
 253   E_delB..         delB*wgdpinc =e= SUM[c, xexp(c)*p(c,"dom") - xdem(c,"imp")*p(c,"imp")];
 254   
 255   E_OBJ..          OBJ =e= 1;
 256   
 257  *--- Initialize levels variables
 258   xfac_f.l(i)      = xfac_f0(i);
 259   xcomp.l(c,lu)    = xcomp0(c,lu);
 260   x.l(c,s,lu)      = x0(c,s,lu);
 261   xfac.l(f,i)      = xfac0(f,i);
 262   xtot.l(lf)       = xtot0(lf);
 263   xexp.l(c)        = xexp0(c);
 264   xfac_i.l(f)      = xfac_i0(f);
 265   xdem.l(c,s)      = xdem0(c,s);
 266   xtot.l(lf)       = xtot0(lf);
 267   z.l(i)           = z0(i);
 268   pcomp.l(c,lu)    = pcomp0(c,lu);
 269   pfac_f.l(i)      = pfac_f0(i);
 270   pfac.l(f,i)      = pfac0(f,i);
 271   p.l(c,s)         = p0(c,s);
 272   p.l(i,s)         = p0(i,s);
 273   ptot.l(lf)       = ptot0(lf);
 274   wtot.l(lf)       = wtot0(lf);
 275   wgdpinc.l        = wgdpinc0;
 276   wgdpexp.l        = wgdpexp0;
 277   delB.l           = delB0;
 278   pfimp.l(i)       = pfimp0(i);
 279   phi.l            = phi0;
 280   fqexp.l(c)       = fqexp0(c);
 281   ftot.l(lf)       = ftot0(lf);
 282   afac.l(f,i)      = afac0(f,i);
 283   ffac_I.l(f)      = ffac_I0(f);
 284   ffac.l(f,i)      = ffac0(f,i);
 285   OBJ.l            = 1;
 286   
 287  model simple /all/;
 288  *======================= (5) Simulation Closure and Shocks ================
 289  * Exogenous Variables in standard closure
 290   afac.fx(f,i)     = afac0(f,i);
 291   ffac.fx(f,i)     = ffac0(f,i);
 292   fqexp.fx(c)      = xexp0(c);
 293   ftot.fx(lf)      = ftot0(lf);
 294   pfimp.fx(i)      = pfimp0(i);
 295   phi.fx           = phi0;
 296   xfac_i.fx(f)     = xfac_i0(f);
 297   
 298  pcomp.fx(c,lu)$(xcomp0(c,lu)=0) = 1;
 299  xcomp.fx(c,lu)$(xcomp0(c,lu)=0) = 0;
 300   
 301  option sysout=on;
 302   
 303  simple.holdfixed=1;     ! assist check that n.equ = n.endogenous var
 304  simple.iterlim=0;       ! dummy simulation to test calibration
 305  simple.tolinfrep=1E-8;
 306  * solve simple using mcp; ! would abort if initial values not a solution
 307   solve simple maximizing obj using NLP;
 308   
 309  *--- Closure changes/Swaps
 310   xfac.fx("capital",i) = xfac0("capital",i);   ! fix industry capital stocks
 311   ffac.lo("capital",i) = -INF;
 312   ffac.up("capital",i) = +INF;
 313   ffac.l("capital",i)  = ffac0("capital",i);
 314   
 315   ffac_I.fx("capital") = ffac_I0("capital");   ! unfix total capital stock
 316   xfac_i.lo("capital") = -INF;
 317   xfac_i.up("capital") = +INF;
 318   xfac_i.l("capital")  = xfac_i0("capital");
 319   
 320  *--- SHOCKS
 321  pfimp.fx(i) = pfimp0(i)*1.10;  !Global 10pct import tariff-equivalent
 322   
 323  *--- Solve model
 324  simple.reslim=19000;
 325  simple.iterlim=200;
 326  simple.holdfixed=1;
 327  *solve simple using MCP;
 328   solve simple maximizing obj using NLP;
 329   
 330  *======================= (6) Simulation Results ==========================
 331  Parameter
 332   LGDP             Laspeyeres GDP quantity index
 333   PGDP             Paasche GDP quantity index
 334   CH_XGDPINC       Percentage change in Fisher (ideal) GDP quantity index
 335   CH_Z(i)          Percentage change in output of industries
 336   CH_X(c,s,lu)     Percentage change in intermediate demand
 337   CH_XFAC(f,i)     Percentage change in factor demand
 338   CH_PFAC(f,i)     Percentage change in price of factors
 339   CH_PFAC_F(i)     Percentage change in composite price of factors
 340   CH_P(c,s)        Percentage change in basic prices
 341   CH_WGDPINC       Percentage change in nominal GDP income side
 342   CH_WGDPEXP       Percentage change in nominal GDP expenditure side
 343   CH_DELB          Ordinary change in ratio nominal trade balance to GDP;
 344   
 345   LGDP = SUM[i,xfac_f.l(i)*pfac_f0(i)]  / SUM[i,xfac_f0(i)*pfac_f0(i)];
 346   PGDP = SUM[i,xfac_f.l(i)*pfac_f.l(i)] / SUM[i,xfac_f0(i)*pfac_f.l(i)];
 347   CH_XGDPINC = [SQRT(LGDP*PGDP)-1]*100;
 348   CH_Z(i)                  = (z.l(i)/z0(i)-1)*100;
 349   CH_X(c,s,lu) $x0(c,s,lu) = (x.l(c,s,lu)/x0(c,s,lu)-1)*100;
 350   CH_XFAC(f,i) $xfac0(f,i) = (xfac.l(f,i)/xfac0(f,i)-1)*100;
 351   CH_PFAC(f,i) $pfac0(f,i) = (pfac.l(f,i)/pfac0(f,i)-1)*100;
 352   CH_PFAC_F(i) $pfac_f0(i) = (pfac_f.l(i)/pfac_f0(i)-1)*100;
 353   CH_P(c,s)                = (p.l(c,s)/p0(c,s)-1)*100;
 354   CH_WGDPINC               = (wgdpinc.l/wgdpinc0-1)*100;
 355   CH_WGDPEXP               = (wgdpexp.l/wgdpexp0-1)*100;
 356   CH_DELB                  = (delB.l-delB0);
 357   
 358  Display CH_Z,CH_XFAC,CH_PFAC,CH_PFAC_F,CH_P,CH_WGDPINC,CH_XGDPINC,CH_WGDPEXP,CH_DELB;
 359   
 360  *---Export results to GDX
 361  EXECUTE_UNLOAD 'RESULTS', CH_Z,CH_XFAC, CH_PFAC, CH_PFAC_F,CH_P, CH_WGDPINC,
 362                            CH_XGDPINC, CH_WGDPEXP,  CH_DELB;
