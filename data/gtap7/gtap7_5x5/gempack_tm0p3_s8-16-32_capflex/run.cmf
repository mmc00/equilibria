! gtap7_5x5 uniform 0.3% shock to import tariff power (tm) - GEMPACK / GTAPv7
! STANDARD GTAP closure (GEMPACK gtapv7.cmf): dpsave EXOGENOUS, no swaps. Capital-account
! variant: capflex (RORDELTA=1). capFix (RORDELTA=0) returns differ; capFlex (RORDELTA=1) equalize.
Auxiliary files = C:\runGTAP375\gtapv7 ;

file GTAPSETS = sets.har ;
file GTAPDATA = basedata.har ;
file GTAPPARM = default_tm0p3_s8-16-32_capflex.prm ;
file GTAPSUM  = summary.har ;
file WELVIEW  = decomp.har ;
file GTAPVOL  = volume.har ;
Updated file GTAPDATA = updated_tm0p3_s8-16-32_capflex.har ;

Method = Gragg ;
Steps  = 8 16 32 ;
Automatic accuracy = no ;
Subintervals = 1 ;

Verbal Description =
gtap7_5x5 uniform 0.3pct shock to import tariff power (tm), standard GTAP closure, capflex (RORDELTA=1) ;

Exogenous
          pop
          psaveslack pfactwld
          profitslack incomeslack endwslack
          cgdslack
          tradslack
          ams atm atf ats atd
          aosec aoreg avasec avareg
          aintsec aintreg aintall
          afcom afsec afreg afecom afesec afereg
          aoall afall afeall
          au dppriv dpgov dpsave
          to tinc
          tpreg tm tms tx txs
          qe
          qesf ;
Rest Endogenous ;

Shock tm = uniform 0.3 ;

CPU = yes ;
NDS = yes ;
log file = yes ;
Extrapolation accuracy file = NO ;
