! altertax closure, tms rate +10% on every flow - GEMPACK / GTAPv7
Auxiliary files = C:\runGTAP375\gtapv7 ;

file GTAPSETS = sets.har ;
file GTAPDATA = basedata.har ;
file GTAPPARM = parameters.prm ;
file GTAPSUM  = summary.har ;
file WELVIEW  = decomp.har ;
file GTAPVOL  = volume.har ;
Updated file GTAPDATA = updated_altertax.har ;

Method = Gragg ;
Steps  = 8 16 32 ;
Automatic accuracy = no ;
Subintervals = 1 ;

Verbal Description =
altertax closure, tariff rate up 10pct on every flow ;

Exogenous
          pop
          psaveslack pfactwld
          profitslack incomeslack endwslack
          tradslack
          ams atm atf ats atd
          aosec aoreg avasec avareg
          aintsec aintreg aintall
          afcom afsec afreg afecom afesec afereg
          aoall afall afeall
          au dppriv dpgov dpsave
          to tinc
          tpreg tm tms tx txs
          qe
          qesf
          del_tbalry("Oceania")
          del_tbalry("EastAsia")
          del_tbalry("SEAsia")
          del_tbalry("SouthAsia")
          del_tbalry("NAmerica")
          del_tbalry("LatinAmer")
          del_tbalry("EU_28")
          del_tbalry("MENA")
          del_tbalry("SSA")
          cgdslack("RestofWorld") ;
Rest Endogenous ;

shock tms(COMM,REG,REG) = select from file tms_rate10.shk ;

CPU = yes ;
NDS = yes ;
log file = yes ;
Extrapolation accuracy file = NO ;
